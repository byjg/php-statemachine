{
  "name": "byjg/statemachine",
  "description": "Finite State Machine implementation with conditional transitions and state actions",
  "require": {
    "php": ">=8.3 <8.7"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\StateMachine\\": "src/"
    }
  },
  "autoload-dev": {
      "psr-4": {
      "Tests\\": "tests/"
      }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "byjg/serializer": "^7.0",
    "psalm/phar": "^6.16"
  },
  "suggest": {
    "byjg/serializer": "To load the machine definition from a YAML or JSON file"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm.phar"
  },
  "license": "MIT",
  "prefer-stable": true,
  "minimum-stability": "dev"
}
