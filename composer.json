{
  "name": "byjg/statemachine",
  "description": "Finite State Machine implementation with conditional transitions and state actions",
  "require": {
    "php": ">=8.3 <8.7"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\StateMachine\\": "src/"
    }
  },
  "autoload-dev": {
      "psr-4": {
      "Tests\\": "tests/"
      }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "byjg/serializer": "^7.0",
    "symfony/workflow": "^8.1",
    "symfony/event-dispatcher": "^8.1"
  },
  "suggest": {
    "byjg/serializer": "To load the machine definition from a YAML or JSON file"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT",
  "prefer-stable": true,
  "minimum-stability": "dev"
}
