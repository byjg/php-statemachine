{
  "name": "byjg/statemachine",
  "description": "Finite State Machine implementation with conditional transitions and state actions",
  "require": {
    "php": ">=8.3 <8.6"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\StateMachine\\": "src/"
    }
  },
  "autoload-dev": {
      "psr-4": {
      "Tests\\": "tests/"
      }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.5",
    "vimeo/psalm": "^5.9|^6.13"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm --threads=1"
  },
  "license": "MIT",
  "prefer-stable": true,
  "minimum-stability": "dev"
}
